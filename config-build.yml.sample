docker_registry: registry.cloudbase.it
docker_push_images: false
docker_images_tag: 1.0.3
docker_template: ubuntu18.04
kolla_containers_namespace: custom
coriolis_containers_namespace: custom
vmware_disklib_url: https://cloudbase.it/downloads/VMware-vix-disklib-6.0.3-4888596.x86_64.tar.gz
libnfs_rpm_url: https://cloudbase.it/downloads/libnfs-1.10.0-1.x86_64.rpm
libqemu_url: https://cloudbase.it/downloads/libqemu.so.gz
coriolis_config_directory_path: /etc/coriolis
coriolis_certs_path: "{{ coriolis_config_directory_path }}/ssl"
export_providers: ['openstack', 'oracle-vm', 'opc', 'vmware', 'aws', 'scvmm']
import_providers: ['openstack', 'oracle-vm', 'opc', 'oci', 'azure', 'scvmm']
