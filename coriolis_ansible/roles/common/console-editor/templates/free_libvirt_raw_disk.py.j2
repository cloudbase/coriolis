#
# When a Coriolis deployment is created without cloning disks, the replicated
# raw volumes are attached directly to the migrated VM. After the VM is
# deleted, those volumes remain in "attached" status in the SQLite DB and
# cannot be picked up by new transfers. This script lets operators inspect
# the DB and reset stuck volumes back to "available".
#
# Usage:
#   python3 /root/free_libvirt_raw_disk.py list [--status STATUS]
#   python3 /root/free_libvirt_raw_disk.py free --wwn WWN [WWN ...]
#   python3 /root/free_libvirt_raw_disk.py free --all [--yes]
#
# The DB file is taken from (in order of precedence):
#   1. --db-file argument
#   2. CORIOLIS_LIBVIRT_PROVIDER_DB_FILE environment variable
#   3. Default: /opt/coriolis/libvirt_provider_db.sqlite

import argparse
import os
import sqlite3
import sys

from prettytable import PrettyTable

DEFAULT_DB_FILE = "/opt/coriolis/libvirt_provider_db.sqlite"

STATUS_AVAILABLE = "available"
STATUS_CLAIMED = "claimed"
STATUS_ATTACHED = "attached"
STATUS_UNAVAILABLE = "unavailable"

ALL_STATUSES = (STATUS_AVAILABLE, STATUS_CLAIMED, STATUS_ATTACHED, STATUS_UNAVAILABLE)
STUCK_STATUSES = (STATUS_CLAIMED, STATUS_ATTACHED)

# Columns shown in the table: (header label, callable that extracts the cell value
# from a row)
DISPLAY_COLUMNS = [
    ("id",          lambda r: r["id"]),
    ("status",      lambda r: r["status"] or ""),
    ("wwn",         lambda r: r["wwn"] or ""),
    ("serial",      lambda r: r["serial"] or ""),
    ("host",        lambda r: r["host"] or ""),
    ("size_gb",     lambda r: f"{r['size'] / (1024 ** 3):.1f}" if r["size"] else "?"),
    ("path",        lambda r: r["path"] or ""),
    ("pool_name",   lambda r: r["pool_name"] or ""),
    ("volume_name", lambda r: r["volume_name"] or ""),
]


def _db_file_path(args):
    return (
        getattr(args, "db_file", None) or
        os.environ.get("CORIOLIS_LIBVIRT_PROVIDER_DB_FILE") or
        DEFAULT_DB_FILE
    )


def _connect(db_file, write=False):
    if not os.path.isfile(db_file):
        print(f"ERROR: DB file not found: {db_file}", file=sys.stderr)
        sys.exit(1)

    if write and not os.access(db_file, os.W_OK):
        print(
            f"ERROR: DB file is not writable: {db_file}\n"
            "       Try re-running with sudo.",
            file=sys.stderr,
        )
        sys.exit(1)

    conn = sqlite3.connect(db_file)
    conn.row_factory = sqlite3.Row
    return conn


def _print_disks(rows):
    if not rows:
        print("(no disks found)")
        return

    table = PrettyTable(field_names=[label for label, _ in DISPLAY_COLUMNS])
    table.align = "l"
    for row in rows:
        table.add_row([extractor(row) for _, extractor in DISPLAY_COLUMNS])

    print(table)


def cmd_list(args):
    status_filter = getattr(args, "status", None)
    if status_filter and status_filter not in ALL_STATUSES:
        print(
            f"ERROR: unknown status {status_filter!r}. "
            f"Valid values: {', '.join(ALL_STATUSES)}",
            file=sys.stderr,
        )
        sys.exit(1)

    db_file = _db_file_path(args)
    conn = _connect(db_file)

    if status_filter:
        query = "SELECT * FROM rawdisks WHERE status = ? ORDER BY id"
        rows = conn.execute(query, (status_filter,)).fetchall()
        print(f"Disks with status={status_filter!r} in {db_file}:")
    else:
        rows = conn.execute("SELECT * FROM rawdisks ORDER BY id").fetchall()
        print(f"All disks in {db_file}:")

    _print_disks(rows)
    conn.close()


def cmd_free(args):
    wwns = getattr(args, "wwn", None) or []
    free_all = getattr(args, "all", False)
    yes = getattr(args, "yes", False)

    if not (wwns or free_all):
        print("ERROR: specify at least one --wwn or use --all", file=sys.stderr)
        sys.exit(1)

    db_file = _db_file_path(args)
    conn = _connect(db_file, write=True)

    if free_all:
        placeholders = ",".join("?" * len(STUCK_STATUSES))
        query = f"SELECT * FROM rawdisks WHERE status IN ({placeholders}) ORDER BY id"
        rows = conn.execute(query, STUCK_STATUSES).fetchall()

        if not rows:
            print("No disks in 'attached' or 'claimed' state.")
            conn.close()
            return

        print(f"The following disks will be reset to '{STATUS_AVAILABLE}':")
        _print_disks(rows)

        if not yes:
            answer = input("\nProceed? [y/N] ").strip().lower()
            if answer not in ("y", "yes"):
                print("Aborted.")
                conn.close()
                return

        query = f"UPDATE rawdisks SET status = ? WHERE status IN ({placeholders})"
        conn.execute(query, (STATUS_AVAILABLE, *STUCK_STATUSES))
        conn.commit()
        print(f"Released {len(rows)} disk(s).")
        conn.close()
        return

    released = 0
    for wwn in wwns:
        query = "SELECT * FROM rawdisks WHERE wwn = ?"
        row = conn.execute(query, (wwn,)).fetchone()
        if not row:
            print(f"WARNING: no disk found with wwn={wwn!r}", file=sys.stderr)
            continue

        if row["status"] == STATUS_AVAILABLE:
            print(f"Disk {wwn!r} is already '{STATUS_AVAILABLE}', skipping.")
            continue

        if row["status"] == STATUS_UNAVAILABLE:
            print(
                f"WARNING: disk {wwn!r} is '{STATUS_UNAVAILABLE}' "
                f"(reason: {row['unavailable_reason'] or 'n/a'}). "
                "Freeing it anyway."
            )

        query = "UPDATE rawdisks SET status = ? WHERE wwn = ?"
        conn.execute(query, (STATUS_AVAILABLE, wwn))
        conn.commit()

        print(f"Released disk: wwn={wwn!r}  path={row['path']!r}  host={row['host']!r}")
        released += 1

    if released:
        print(f"\nReleased {released} disk(s).")

    conn.close()


def get_parser():
    parser = argparse.ArgumentParser(
        description=(
            "Inspect and free Coriolis libvirt raw disk allocations that are stuck in "
            "'attached' or 'claimed' state after a non-clone deployment was deleted."
        )
    )
    parser.add_argument(
        "--db-file",
        default=None,
        metavar="PATH",
        help=(
            f"Path to the SQLite DB file "
            f"(default: $CORIOLIS_LIBVIRT_PROVIDER_DB_FILE or {DEFAULT_DB_FILE})"
        ),
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="List raw disks.")
    list_parser.add_argument(
        "--status",
        choices=ALL_STATUSES,
        default=None,
        help="Filter by disk status (default: show all).",
    )
    list_parser.set_defaults(func=cmd_list)

    free_parser = subparsers.add_parser(
        "free",
        help=(
            "Reset 'attached' or 'claimed' disks back to 'available'. "
            "Use --all to free all stuck disks, or --wwn to target specific disks."
        ),
    )
    target_group = free_parser.add_mutually_exclusive_group(required=True)
    target_group.add_argument(
        "--wwn",
        nargs="+",
        metavar="WWN",
        help="WWN(s) of the disk(s) to free.",
    )
    target_group.add_argument(
        "--all",
        action="store_true",
        help="Free all disks currently in 'attached' or 'claimed' state.",
    )
    free_parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="Skip the confirmation prompt (only relevant with --all).",
    )
    free_parser.set_defaults(func=cmd_free)

    return parser


def main():
    parser = get_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
