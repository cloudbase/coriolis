#!/bin/bash

set -eux -o pipefail

if [ -e "/dev/log" ]
then
    rm -rf /dev/log
fi

ln -sf "{{ coriolis_logger_socket_file }}" /dev/log

if [ "x${RUN_DBSYNC:-''}" != "x" ] && [ "x${RUN_DBSYNC:-''}" = "xyes" ]
then
    if [ -x "/usr/local/bin/coriolis-dbsync" ]
    then
        /usr/local/bin/coriolis-dbsync
    fi
fi

CA_FOLDER="{{ coriolis_config_dir }}/ssl/ca"
CERTIFI_DIR="$(python3 -c 'import certifi; import os; print(os.path.dirname(certifi.__file__))')"
CERTIFI_CA_PATH="$CERTIFI_DIR/cacert.pem"

if [ -d "$CA_FOLDER" ] && [ ! -z "$(ls -A $CA_FOLDER)" ];then
    if [ -e "/etc/debian_version" ]; then
        # Copy over Coriolis CA certificates
        for cert in "$CA_FOLDER"/*; do
            # Validate $cert before copying into CA store
            openssl x509 -noout -in $cert

            file=$(basename "$cert")
            cp $cert "/usr/local/share/ca-certificates/coriolis-ca-${file%.*}.crt"

            cat $cert >> $CERTIFI_CA_PATH; echo >> $CERTIFI_CA_PATH
        done
        update-ca-certificates
    elif [ -e "/etc/redhat-release" ]; then
        # Copy over Coriolis CA certificates
        for cert in "$CA_FOLDER"/*; do
            # Validate $cert before copying into CA store
            openssl x509 -noout -in $cert

            file=$(basename "$cert")
            cp $cert "/etc/pki/ca-trust/source/anchors/coriolis-ca-$file"

            cat $cert >> $CERTIFI_CA_PATH; echo >> $CERTIFI_CA_PATH
        done
        update-ca-trust
    fi
fi

if [ "${RUN_OPENISCSI:-no}" = "yes" ]; then
    # Start the iSCSI initiator service, used by the Nutanix provider.
    /etc/init.d/iscsid start
fi

exec "$@"
