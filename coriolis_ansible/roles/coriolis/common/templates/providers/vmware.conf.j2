[vmware_vsphere_migration_provider]

### Export parameters:

# Required in order to set the compatibility of the vixDiskLib release
# Coriolis will use during replication/CBT-based migration from VMWare.
# This value should ideally match the ESXi/vCenter hosts versions.
vixdisklib_compatibility_version = 8.0

# The path where the SOs for vixDiskLib are located:
vixdisklib_library_directory = {{ coriolis_vmware_vix_disklib_dir }}

# Whether or not Coriolis should attempt to automatically enable CBT on
# the VM before Replication.
# This requires that the VM have no pre-existing snapshots.
automatically_enable_cbt = False

# Whether or not to skip pre-export NFC connectivity validation against
# ESXi hosts. When false (default), Coriolis validates TCP/902 reachability
# for hosts that may be selected by vCenter for NBD/NBDSSL snapshot transfers.
skip_nfc_validation = False


# Path to the vixdisklib configuration file.
vixdisklib_config_location = {{ coriolis_vmware_vix_disklib_config_path }}

### Import parameters:
# The name of the datacenter to import to.
# import_datacenter = datacenter1

# The inventory path of the VMware datastore from the selected
# 'import_datacenter' in which to create Migrated VMs. Note that only the
# VMX and other such VM files will be stored in the datastore, as the VM's
# disks will be stored within the datastores selected for each, respectively.
# import_datastore = datastore0

# The inventory path of the compute cluster from the selected
# 'import_datacenter' VMs should be migrated on.
# (e.g. 'Cluster Folder 1/Cluster X')
# import_cluster = CI

# The name of the resource pool to deploy the migrated VMs in. Must reside
# within the seleted 'import_cluster'. If none is provided, the default
# resource pool for the cluster will be used.
# import_resource_pool = Resources

# Inventory path of a pre-existing VM folder on the selected
# 'Import Datacenter' in which to put the migrated VM(s).
# Must be a slash-separated absolute path starting from the top-level
# of the VMware installation, excluding the datacenter. (e.g: 'Folder 1/Folder 2').
# If none is provided, VMs will be migrated into the top
# level of the selected 'Import Datacenter'.
# import_vm_folder = Migrated Coriolis VMs

# Whether or not Coriolis should power on machines after migrating them.
# Internal default is false.
# power_on_migrated_machines = true

# Whether or not Coriolis should attempt to enable CBT on migrated VMs.
# Note that the selected datastores for the VM must support CBT (NFS or VMFS2)
import_enable_cbt = false

# The VMware guest ID (e.g. 'ubuntu64Guest') for the VMs to be migrated to VMware.
# Must be supported by the host(s) within the selected 'import_cluster'.
# Internal default is 'genericLinuxGuest'.
# imported_vm_guest_id = ubuntu64Guest

# Whether or not Coriolis should preserve the MAC addresses of the network
# interfaces of the migrated VMs. In order to avoid MAC address conclicts,
# please ensure that the addresses will not conflict with existing VMware VMs
# on the same network(s), or that the source and target platforms don't share
# the same L2 VM network.
# Internal default is false.
# preserve_mac_addresses = true

# The network interface device model to use for migrated virtual machines.
# If using a paravirtual device model like 'VMXNET3', enabling the OSMorphing
# process before final VM creation is recommended.
# Must be one of "E1000", "E1000e", or "VMXNET3".
nics_device_model = VMXNET3

# Whether or not Coriolis should create virtual disks as First Class Disks.
# Requires vCenter >= 6.7. If disabled, a shell VM template must be configured
# via 'migr_disk_shell_template'. Cloning Replica disks is only supported with FCD.
use_first_class_disks = true

# The VMware hardware version (e.g. 'vmx-12') for the migrated VMs.
# Must be supported by the selected 'import_cluster'.
# If unset, the latest available one will be automatically chosen.
# imported_vm_hardware_version = vmx-14

# Whether or not Coriolis should reconfigure the Migrated VMs to use DHCP
# on all network interfaces during the OSMorphing process.
# Internal default is false.
# set_dhcp = true

# Inventory path of the VM folder on the selected 'import_datacenter' in which
# to house temporary minion VMs, excluding the top-level datacenter.
# (e.g. 'VM Folder 1/VM Folder 2')
# migr_minion_folder = Coriolis Minions

# Mapping between operating system types ('linux' or 'windows') and the
# inventory paths of pre-existing VM templates available on VMware.
# These templates will be used by Coriolis during the disk transfer and
# OSMorphing processes, and must be configured to run in a network with DHCP
# enabled for them to be automatically allocated an IP address.
# Their IP address must be reachable from the Coriolis Worker service(s)
# installed as part of Coriolis. The templates must have VMware tools
# installed and configured to report the IP address(es) to VMware.
# migr_template_map = linux: Coriolis Minions/coriolis-minion-template-20.04

# Inventory path of an empty VM template to be used as a proxy for disk operations.
# The template's only requirement is having a SCSI bus. The template has no other
# requirements related to sizing/OS type/etc, and can have no root disk or NICs
# whatsoever.
# If none is provided, a template from the 'migr_template_map' will be used.
# migr_disk_shell_template = Coriolis Minions/coriolis-disks-operations-shell-template

# Mapping between operating system types ('linux' or 'windows') and the names of
# pre-existing usernames on the template(s) specified in the 'migr_template_map'
# option. The users must have admin privileges within the templates.
# migr_template_username_map = linux: coriolis

# Mapping between operating system types ('linux' or 'windows') and the passwords
# of pre-existing usernames on the template(s) specified in the 'migr_template_map'
# option. The users must have admin privileges within the templates.
# migr_template_password_map = linux: coriolis123

# The inventory path of the VMware datastore from the selected 'import_datacenter'
# in which to store temporary minion VMs. If none is provided,
# the one preset within the template will be used.
# migr_minion_datastore = datastore0

# The inventory path of the compute cluster from the selected 'import_datacenter'
# which temporary minion VMs should be created on. (e.g. 'Cluster Folder 1/Cluster X').
# If none is provided, the selected 'import_cluster' will be used.
# migr_minion_cluster = CI

# The name of the resource pool in which temporary minion VMs should be created on.
# Must reside within the seleted 'import_datacenter'. If none is provided, the
# default resource pool for the selected 'migr_minion_cluster' will be used.
# migr_minion_resource_pool = Resources

# User-hosted URL for the Windows VMWare Tools executable. This option should only be
# used when Internet access for the Windows Worker is restricted or limited, or if the
# official URL is not accessible.
# windows_vmware_tools_url =

# Disk controller to be used for migrated VM's volumes. Accepted values are:
# 'SCSI', 'IDE', 'SATA',
disk_controller = SCSI

# What mechanism to use when sending disk data from the Coriolis installation
# to the temporary VMs on the target VMWare to be written to their
# respective disk. The HTTPS-based transfer mechanism (TCP/5566) is faster but
# might not work if there are firewalls in the way. The SSH-based transfer
# mechanism (TCP/22) is more costly but will be allowed by most firewalls since
# SSH access from the Coriolis installation to the temporary worker VM is always
# required. Coriolis automatically sets security groups rules for the temporary
# VMs accordingly.
# Choices are 'SSH' or 'HTTPS'. Default is 'HTTPS'.
data_transfer_mechanism = HTTPS

# Location of the Cloudbase-Init ZIP for amd64 systems
default_cloudbaseinit_x64_url = https://www.cloudbase.it/downloads/CloudbaseInitSetup_Stable_x64.zip
