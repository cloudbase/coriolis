{
  "$schema": "http://cloudbase.it/coriolis/schemas/osmorphing_resources#",
  "type": "object",
  "properties": {
    "osmorphing_connection_info": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "$ref": "#/definitions/nullableString"
        },
        "pkey": {
          "$ref": "#/definitions/nullableString"
        },
        "cert_pem": {
          "type": "string"
        },
        "cert_key_pem": {
          "type": "string"
        }
      },
      "required": ["ip", "port", "username"]
    },
    "osmorphing_info": {
      "type": "object",
      "properties": {
        "os_type": {
          "enum": ["bsd", "linux", "osx", "solaris", "windows"]
        },
        "nics_info": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nics_set_dhcp": {
          "type": "boolean",
          "default": "true"
        },
        "ignore_devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "osmorphing_parameters": {
          "type": "object",
          "properties": {
            "retain_user_credentials": {
              "type": "boolean",
              "default": false,
              "description": "Keep the guest user accounts during OS morphing. When false, OS morphing creates the cloud-init user."
            },
            "cloudbase_init_plugins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Cloudbase-Init plugin class names for Windows guests. When set, this list is written into the guest. When omitted, the provider plugin list is used, then coriolis.conf, then the Windows morphing default."
            }
          }
        }
      },
      "required": ["os_type"],
      "additionalProperties": true
    }
  },
  "required": ["osmorphing_connection_info", "osmorphing_info"],
  "definitions": {
    "nullableString": {
      "oneOf": [{
        "type": "string"
      }, {
        "type": "null"
      }]
    }
  }
}
