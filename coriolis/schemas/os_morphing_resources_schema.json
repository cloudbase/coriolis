{
  "$schema": "http://cloudbase.it/coriolis/schemas/osmorphing_resources#",
  "type": "object",
  "properties": {
    "osmorphing_connection_info": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "$ref": "#/definitions/nullableString"
        },
        "pkey": {
          "$ref": "#/definitions/nullableString"
        },
        "cert_pem": {
          "type": "string"
        },
        "cert_key_pem": {
          "type": "string"
        }
      },
      "required": ["ip", "port", "username"]
    },
    "osmorphing_info": {
      "type": "object",
      "properties": {
        "os_type": {
          "enum": ["bsd", "linux", "osx", "solaris", "windows"]
        },
        "nics_info": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nics_set_dhcp": {
          "type": "boolean",
          "default": true,
          "description": "Sets whether or not to configure the VM to use DHCP during the OSMorphing stage. When disabled, guest static IPs will be preserved after the migration."
        },
        "ignore_devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "osmorphing_parameters": {
          "type": "object",
          "properties": {
            "retain_user_credentials": {
              "type": "boolean",
              "default": false,
              "description": "Prevents the destination cloud provisioning from resetting the pre-existing credentials. When disabled, the destination platform may also create a provisioned cloud guest user."
            },
            "cloudbase_init_plugins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Cloudbase-Init plugin class names for Windows guests. When set, this list is written into the guest. When omitted, coriolis.conf is used, then the provider plugin list, then the built-in list in Coriolis Windows OS morphing."
            }
          }
        }
      },
      "required": ["os_type"],
      "additionalProperties": true
    }
  },
  "required": ["osmorphing_connection_info", "osmorphing_info"],
  "definitions": {
    "nullableString": {
      "oneOf": [{
        "type": "string"
      }, {
        "type": "null"
      }]
    }
  }
}
