# Kolla will error out if the redis Ansible server group is missing
# as the keystone.conf.j2 template rendering requires this defined.
# Keystone works independently of the Redis service (this is disabled
# anyway via `enable_redis: no` from /etc/kolla/globals.yml), but
# unfortunately, the Kolla Keystone Ansible role is not atomic, and it
# requires this (even though it's not used anyway when Redis is disabled).
[redis:children]
control

